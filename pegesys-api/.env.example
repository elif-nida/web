# Bu dosyayı .env adıyla kopyalayıp doldurun. .env asla GitHub'a gönderilmez.

# Oturum anahtarlarını imzalamak için uzun, rastgele bir değer
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=degistirin

# Boş bırakılırsa yerel SQLite dosyası (pegesys.db) kullanılır.
# Canlıda PostgreSQL adresi: postgresql://kullanici:sifre@sunucu:5432/veritabani
DATABASE_URL=

# Sitenin adresi (CORS). Birden fazlaysa virgülle ayırın.
ALLOWED_ORIGINS=http://localhost:8000,https://elif-nida.github.io

# İlk açılışta hiç yönetici yoksa bu bilgilerle bir yönetici oluşturulur.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# (İsteğe bağlı) Yeni mesaj gelince e-posta bildirimi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
